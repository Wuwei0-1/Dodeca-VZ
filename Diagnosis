            self.char_embed = nn.Embedding(256, 512)

        def fold(self, x):
            current_dim = x.shape[-1]
            if current_dim <= 4:
                return x[:, :4]
            half = current_dim // 2
            left = x[:, :half]
            right = x[:, half:2*half]
            folded = torch.tanh(left + right)
            return self.fold(folded)

        def forward(self, text):
            ids = torch.tensor([ord(c) for c in text if ord(c) < 256], dtype=torch.long)
            if len(ids) == 0:
                ids = torch.tensor([32], dtype=torch.long)
            vectors = self.char_embed(ids)
            sentence_vec = torch.mean(vectors, dim=0, keepdim=True)
            packet = self.fold(sentence_vec)
            return packet

